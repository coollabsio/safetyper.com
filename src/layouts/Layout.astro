---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A Grammarly alternative, where YOU own what you type on your keyboard.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/android-launchericon-48-48.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="72x72"
      href="/android-launchericon-72-72.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/android-launchericon-96-96.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="144x144"
      href="/android-launchericon-144-144.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/android-launchericon-192-192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/android-launchericon-512-512.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#ffc40d" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="Description" content={description} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heyandras" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://cdn.coollabs.io/og-images/safetyper.png"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Safetyper" />
    <meta
      property="og:image"
      content="https://cdn.coollabs.io/og-images/safetyper.png"
    />
    <title>{title}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden font-sans leading-relaxed text-fg antialiased">
    <Navigation />
    <main class="mx-auto w-full max-w-6xl flex-1">
      <div class="pt-12 text-center md:pt-20">
        <slot />
      </div>
    </main>
    <Footer />
    <style is:global>
      @reference "../styles/global.css";

      html {
        background-color: var(--color-app);
        color: var(--color-fg);
        color-scheme: dark;
        overflow-x: hidden;
      }
      @supports (overflow-x: clip) {
        html,
        body {
          overflow-x: clip;
        }
      }
      /* Green glow at the top, same shape as coollabs.io and the Coolify login page. */
      body {
        background:
          radial-gradient(circle at 50% 0%, color-mix(in oklab, var(--color-safetyper) 9%, transparent), transparent 34rem),
          var(--color-app);
      }
      ::selection {
        background: color-mix(in oklch, var(--color-safetyper) 45%, transparent);
      }
      .navbar-link {
        @apply flex h-8 items-center gap-2 rounded-md px-2.5 text-sm text-fg-dim transition-colors hover:bg-white/[0.06] hover:text-fg;
      }
      @media (max-width: 639px) {
        .navbar-link {
          @apply h-9 w-full px-3 text-left;
        }
      }
    </style>

    <script
      defer
      data-domain="safetyper.com"
      src="https://analytics.coollabs.io/js/script.tagged-events.js"></script>

    <script>
      const mobileMenuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");

      mobileMenuButton?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
        mobileMenu?.classList.toggle("flex");
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu?.classList.add("hidden");
          mobileMenu?.classList.remove("flex");
        });
      });
    </script>
  </body>
</html>

---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ArrowRight from "reicon/icons/ArrowRight";
import ArrowUpRight from "reicon/icons/ArrowUpRight";
import Code from "reicon/icons/Code";
import Devices from "reicon/icons/Devices";
import HardDrive from "reicon/icons/HardDrive";
import HeartHand from "reicon/icons/HeartHand";
import Key from "reicon/icons/Key";
import PenSparkle from "reicon/icons/PenSparkle";

const features = [
  {
    icon: Key,
    title: "Bring your own key",
    description:
      "Use your own OpenRouter or Groq API key. Your credentials stay on your device, never on our servers.",
  },
  {
    icon: HardDrive,
    title: "Local Ollama models",
    description:
      "Run models locally with Ollama for complete privacy. Your text never leaves your machine — no API calls, no cloud, fully offline.",
    link: { href: "https://github.com/coollabsio/safetyper", label: "Setup guide" },
  },
  {
    icon: Devices,
    title: "Works everywhere",
    description:
      "Browser extension that works on any website — Gmail, Slack, Notion, social media, and more. Write better wherever you type.",
  },
  {
    icon: PenSparkle,
    title: "Grammar & spelling",
    description:
      "Real-time grammar, spelling, and punctuation corrections powered by AI. Catch mistakes as you type, not after you hit send.",
  },
  {
    icon: Code,
    title: "Open source",
    description:
      "Fully open source. Read every line, verify our claims, and contribute. No black boxes, no hidden logic.",
    link: { href: "https://github.com/coollabsio/safetyper", label: "View on GitHub" },
  },
];
---

<Layout title="Safetyper - Keep your words safe & polished">
  <section id="install" class="scroll-mt-20 px-4">
    <a
      href="/philosophy"
      class="inline-flex items-center gap-3 rounded-full bg-white/[0.04] px-4 py-2 text-sm text-fg-dim ring-1 ring-hairline transition-colors hover:bg-white/[0.07] hover:text-fg"
    >
      <span class="size-2 rounded-full bg-safetyper-text"></span>
      Open source and free forever. Read our philosophy
      <Icon icon={ArrowRight} class="size-4" />
    </a>
    <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-semibold tracking-tight text-balance text-fg md:text-6xl">
      Keep your words safe & polished<span class="text-safetyper-text">.</span>
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-base text-pretty text-fg-dim md:text-lg">
      A Grammarly alternative, where YOU own what you type on your keyboard.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="https://chromewebstore.google.com/detail/safetyper/jfgghgeieficifndgplklafkhajffghg"
        target="_blank"
        class="btn btn-primary btn-lg"
      >
        <img src="/icons/chrome.svg" alt="" class="size-4" />
        Add to Chrome
      </a>
      <a
        href="https://addons.mozilla.org/en-US/firefox/addon/safetyper/"
        target="_blank"
        class="btn btn-neutral btn-lg"
      >
        <img src="/icons/firefox.svg" alt="" class="size-4" />
        Add to Firefox
      </a>
    </div>
    <p class="mt-6 text-xs text-fg-faint">Usage-based subscription coming soon.</p>
  </section>

  <section id="features" class="mt-24 scroll-mt-20 px-4">
    <p class="eyebrow">Features</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-fg md:text-3xl">
      Better writing, without giving up your privacy
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-sm text-fg-faint">
      You choose the model. You keep the keys. Your text stays yours.
    </p>

    <div class="mt-10 grid gap-4 text-left sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <article class="card flex flex-col p-5 lg:last:col-span-2">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-safetyper/15 ring-1 ring-safetyper/40">
              <Icon icon={feature.icon} class="size-5 text-safetyper-text" />
            </div>
            <h3 class="mt-4 text-base font-medium text-fg">{feature.title}</h3>
            <p class="mt-2 text-sm text-fg-dim">{feature.description}</p>
            {feature.link && (
              <a
                href={feature.link.href}
                target="_blank"
                class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium text-safetyper-text hover:underline hover:underline-offset-4"
              >
                {feature.link.label}
                <Icon icon={ArrowUpRight} class="size-3.5" />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section id="support" class="mt-28 scroll-mt-20 px-4">
    <p class="eyebrow">Support</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-fg md:text-3xl">
      Free because of our sponsors
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-sm text-fg-faint">
      Safetyper is a <a href="https://coollabs.io?ref=safetyper" class="text-fg-dim underline decoration-fg-faint underline-offset-2 hover:decoration-fg">coolLabs</a>
      project. No investors and no hidden logic. Sponsors keep it independent and open source.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/sponsorships" class="btn btn-primary">
        <Icon icon={HeartHand} class="size-4" />
        Become a sponsor
      </a>
      <a href="/philosophy" class="btn btn-neutral">
        Read our philosophy
        <Icon icon={ArrowRight} class="size-4" />
      </a>
    </div>
  </section>
</Layout>
